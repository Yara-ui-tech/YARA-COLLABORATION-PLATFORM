# ==============================================================================
# YOUNG AFRICANS ROBOTICS ASSOCIATION (YARA) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Vercel / Cloud Run), set these in your hosting environment dashboard.
# NEVER commit real service role keys or secret tokens to git repositories.

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CREDENTIALS (Vite Client-Safe)
# ------------------------------------------------------------------------------
# Required for frontend authentication, real-time subscriptions, and public database access.
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND SERVICE ROLE (Server / Edge Functions ONLY)
# ------------------------------------------------------------------------------
# Required for server-side admin tasks, user role escalations, and automated jobs.
# CRITICAL: DO NOT prefix with VITE_ so it is NEVER exposed to client browser bundles.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# ------------------------------------------------------------------------------
# 3. DAILY.CO VIDEO INTEGRATION (Live Workshops & Mentorship Rooms)
# ------------------------------------------------------------------------------
# Your Daily.co subdomain used for WebRTC live robotics classes.
VITE_DAILY_DOMAIN="yara"
DAILY_API_KEY="your-daily-api-key-optional"

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (Resend / SMTP for Verification & Alerts)
# ------------------------------------------------------------------------------
# Used for certificate delivery, competition confirmation, and password reset.
RESEND_API_KEY="re_your_resend_api_key_here"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (Educator Lesson Plan Assistant & Robotics Assistant)
# ------------------------------------------------------------------------------
# Used for the Teacher / Patron AI lesson planner and robotics simulation aids.
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 6. SYSTEM RUNTIME & DEPLOYMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
APP_URL="https://yara-collaboration-platform.vercel.app"
